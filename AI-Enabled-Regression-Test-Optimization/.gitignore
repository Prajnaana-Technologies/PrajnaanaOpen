# The application never reads a .env. An API key is typed into its window,
# is held in that process only, and is gone when the window closes --
# nothing is written to disk and nothing is remembered between runs. A
# stray .env on somebody's machine should still never be committed.
.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
venv/
.venv/
.pytest_cache/
*.egg-info/

# Zephyr build output. The tracked firmware.bin / firmware.hex are the
# flashable images; everything under build/ is regenerated by west.
src/NRF_Firmware/build/

# Generated at run time, not source.
src/regression/generated_tests/test_ai_generated.py
src/regression/generated_tests/test_from_canonical.py
src/regression/logs/
src/regression/artifacts/kpi/
src/regression/artifacts/governance/
dsp_before.wav
dsp_after.wav

# Per-build firmware fingerprints, written by every run that can read an
# image. Only baseline.json is a deliverable: it is the one the packaged
# build bundles so a fresh install has something to compare against.
src/regression/artifacts/firmware/*.json
!src/regression/artifacts/firmware/baseline.json

# A copy of the canonical document, written only when you ask for one with
# `python -m regression.ai_engine.canonical --out canonical.json`. A run
# never writes or reads one. A committed copy goes stale against the
# requirements and the release note -- the one that was tracked described a
# build two releases old.
src/canonical.json

# The shipped build is tracked in full. *.py[cod] also matches .pyd and
# *.pem matches certifi's cacert.pem, so 52 bundled files were tracked but
# ignored -- after a rebuild a new or renamed .pyd would not be staged
# without -f, and the packaged application would ship incomplete. Named
# narrowly on purpose: a blanket `!bin/_internal/**` also un-ignored
# __pycache__/*.pyc and .pytest_cache/ written under _internal by a run
# from inside the clone, which then appeared as untracked.
!bin/_internal/**/*.pyd
!bin/_internal/certifi/cacert.pem

# Output of running the exe from inside the clone. bin/ is a build artefact
# that happens to be tracked, but nothing under bin/regression/ is: the
# whole tree is run output -- the logs, the generated suite with the
# conftest.py written beside it, and the run's artefacts.
bin/regression/

# Editor and OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# PyInstaller intermediates. bin/ is the shipped build.
build/
dist/
*.spec.bak
